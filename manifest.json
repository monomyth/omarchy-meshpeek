{
  "schemaVersion": 1,
  "id": "local.modelview",
  "name": "Model View",
  "version": "0.1.2",
  "author": "Eugene Ray / Senior Engineer",
  "license": "MIT",
  "description": "Keyboard-first STL/3MF glance via f3d. Default clay (Blender); optional studio profile (3D Artist); inspect edges.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Model View",
    "description": "Optional bar icon; prefer the keybind. Opens last model or file picker.",
    "category": "Hardware",
    "aliases": [
      "stl",
      "3mf",
      "f3d",
      "model-view"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showIcon": false,
      "watchDirs": "",
      "upAxis": "+Z"
    },
    "schema": [
      {
        "key": "showIcon",
        "type": "boolean",
        "label": "Show bar icon (keybind works either way)",
        "defaultValue": false
      },
      {
        "key": "watchDirs",
        "type": "string",
        "label": "Extra dirs for last-export search (colon-separated)",
        "defaultValue": "",
        "description": "Appended after ~/Downloads and ~/Prints when resolving 'last'."
      },
      {
        "key": "upAxis",
        "type": "enum",
        "label": "Up axis",
        "options": [
          "+Z",
          "+Y",
          "-Z",
          "-Y"
        ],
        "defaultValue": "+Z",
        "description": "Print exports are usually +Z up. Blender lane can override."
      }
    ]
  }
}