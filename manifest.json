{
  "schemaVersion": 1,
  "id": "local.meshpeek",
  "name": "Mesh Peek",
  "version": "0.2.1",
  "author": "Eugene Ray / Senior Engineer",
  "license": "MIT",
  "description": "One shortcut: Files selection opens Chromium+Three.js (f3d if installed); else confirm picker.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Mesh Peek",
    "description": "Optional bar icon; prefer Super+Shift+Ctrl+V.",
    "category": "Hardware",
    "aliases": [
      "stl",
      "3mf",
      "f3d",
      "model-view",
      "threejs",
      "web",
      "meshpeek",
      "mesh-peek",
      "peek"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showIcon": false,
      "watchDirs": "",
      "upAxis": "+Z"
    },
    "schema": [
      {
        "key": "showIcon",
        "type": "boolean",
        "label": "Show bar icon (keybind works either way)",
        "defaultValue": false
      },
      {
        "key": "watchDirs",
        "type": "string",
        "label": "Extra dirs for newest-model search (colon-separated)",
        "defaultValue": "",
        "description": "Appended after ~/Downloads and ~/Prints when suggesting newest."
      },
      {
        "key": "upAxis",
        "type": "enum",
        "label": "Up axis",
        "options": [
          "+Z",
          "+Y",
          "-Z",
          "-Y"
        ],
        "defaultValue": "+Z",
        "description": "Print exports are usually +Z up. Blender lane can override."
      }
    ]
  }
}
